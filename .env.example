# Startup seed generation (set SEED_ENABLED=false to skip)
SEED_ENABLED=true
SEED_SATELLITE_COUNT=10
SEED_ENTRY_COUNT=300
SEED_TIME_START=2026-08-06T00:00:00.000Z
SEED_TIME_END=2026-08-07T00:00:00.000Z
SEED_ALTITUDE_MIN=400
SEED_ALTITUDE_MAX=1000
SEED_VELOCITY_MIN=5.0
SEED_VELOCITY_MAX=8.0
# Status mix must sum to 100
SEED_STATUS_HEALTHY_PCT=70
SEED_STATUS_WARNING_PCT=20
SEED_STATUS_CRITICAL_PCT=10
# Fixed RNG seed for reproducible data; set to "none" for non-deterministic
SEED_RANDOM_SEED=42
